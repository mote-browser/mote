---
// The opening: the page fills the screen, then shrinks into the card of a
// Mote window — the site becomes the page Mote is showing. Its manifesto
// scrolls by, then the same window is used for a moment: a new tab, a
// search, a page arriving, the sidebar folded away.
//
// The window follows the app's own layout and colours (ChromeLayout.swift,
// Sidebar.swift, Toolbar.swift, Omnibox.swift, Design.swift), in points.
// Choreography is in story.css; the scroll engine is scene.css.
import "../styles/scene.css";
import "../styles/story.css";
import { site } from "../site";
import Button from "./Button.astro";
import Favicon from "./Favicon.astro";
import Icon from "./Icon.astro";
import Pebble from "./Pebble.astro";

const manifesto = [
  "Every Mac comes with a great web engine.",
  "Mote gives it a browser that feels at home.",
  "Ads and trackers never make it to the page.",
  "Tabs you left behind wait quietly until you need them.",
  "Your passwords stay in your keychain.",
  "No account. Nothing leaves your Mac.",
];

// The manifesto scrolls up through the card over .17–.50 of the story; each
// line is at full strength while it crosses the middle, which, for a block
// this short, happens between about .29 and .39.
const spot = (i: number) => {
  const at = 0.29 + (0.1 * i) / (manifesto.length - 1);
  return `--from: ${(at - 0.02).toFixed(3)}; --to: ${(at + 0.02).toFixed(3)}`;
};

// The sidebar, with the app's "Site icons" setting on: pinned sites show
// their icon, tabs their icon and title. The sites are made up.
const pins = ["post", "tally", "sidetrack"] as const;
const tabs = [
  { title: "Mote", site: "mote" },
  { title: "Weekly planning", site: "tally" },
  { title: "Reading list", site: "shelf" },
  { title: "Lisbon — 7-day forecast", site: "weather" },
  { title: "Recipes for a slow Sunday", site: "kettle" },
] as const;

const captions = [
  { text: "Start anywhere.", from: 0.515, to: 0.585 },
  { text: "Or ask, with the AI you choose.", from: 0.585, to: 0.685 },
  { text: "It reads the web, and shows its sources.", from: 0.685, to: 0.795 },
  { text: "Then fold it all away.", from: 0.795, to: 0.9 },
];

// Asking, as the app does it (Omnibox.swift, AskControls.swift, AskGlow.swift):
// ⌘J lights the composer, the halo round the logo closes on its lowest point
// and drops onto the composer's border, which lights from there. Then a
// question in Research mode, and the chat (ChatView.swift, SearchViews.swift).
const question = "Is walking slowly as good for you as walking fast?";

// The research's parts: each shows, turns while it's searched, then is done.
const parts = [
  { title: "What counts as a slow walk", searches: 2, pages: 5 },
  { title: "Health effects of walking pace", searches: 4, pages: 8 },
  { title: "Joints and recovery", searches: 2, pages: 4 },
  { title: "How much walking is enough", searches: 3, pages: 6 },
];
const partAt = (i: number) => 0.645 + i * 0.006;
const doneAt = (i: number) => 0.668 + i * 0.006;

// The pages it drew on, cited ones numbered, as SourcesStrip shows them.
const sources = [
  { site: "pace", name: "Pace Lab", title: "Walking speed and everyday health", number: 1 },
  { site: "stride", name: "Stride", title: "Why a gentle pace is easier to keep up", number: 2 },
  { site: "trail", name: "Trailhead", title: "Brisk intervals on an ordinary walk", number: 3 },
  { site: "notes", name: "Field Notes", title: "On walking slowly", number: 0 },
] as const;
const sourceAt = (i: number) => 0.683 + i * 0.004;

// The report, word by word from .70 to .78 of the story, each fading in as
// the app's typewriter shows it. A word "{n}" is the chip citing source n.
const report = [
  { kind: "h", words: "Slow walks still count" },
  {
    kind: "p",
    words:
      "Mostly, yes. What matters most is walking often: a relaxed pace on most days carries much of the benefit {1} A gentler pace is also easier on the joints, so it's easier to keep up for longer {2}",
  },
  { kind: "p", words: "Brisk stretches do more for the heart, so fold a few into the walks you already take {3}" },
] as const;
const reportWords = report.flatMap((block) => block.words.split(" "));
const wordStep = 0.078 / reportWords.length;
let wordIndex = 0;
const wordAt = () => {
  const from = 0.7 + wordIndex++ * wordStep;
  return `--from: ${from.toFixed(4)}; --to: ${(from + 0.006).toFixed(4)}`;
};
const cite = (n: number) => sources.find((source) => source.number === n)!.name;
---

<div class="story scene">
  <div class="story-stage scene-stage">
    <div class="story-camera part">
    <div class="story-window part" aria-hidden="true">
      <span class="story-shade part"></span>
      <div class="story-side part">
        <div class="story-pins">
          {
            pins.map((site, i) => (
              <span style={`--i: ${i}`}>
                <Favicon site={site} class="size-[17px]" />
              </span>
            ))
          }
        </div>
        <div class="story-tabs">
          <span class="story-lift part"><i class="story-read part"></i></span>
          {
            tabs.map((tab, i) => (
              <span class:list={["story-row", { "is-first part": i === 0 }]} style={`--i: ${i + 3}`}>
                <Favicon site={tab.site} class="size-4 shrink-0" />
                {tab.title}
              </span>
            ))
          }
          <span class="story-row story-opened part" style="--i: 8">
            <span class="story-swap part">New tab</span>
            <span class="story-swap is-after part"><Icon name="sparkle" class="size-4 shrink-0 p-[1px] text-[#8c8c8c]" />{question}</span>
          </span>
          <span class="story-row story-new part" style="--i: 9"><Icon name="plus" class="size-3" />New tab</span>
        </div>
        <span class="story-foot" style="--i: 10"><Icon name="bookmark" class="size-3.5" /></span>
      </div>
    </div>

    <div class="story-page part">
      <div class="story-glow"></div>
      <canvas class="story-light" data-light></canvas>

      <header class="story-intro part">
        <Pebble id="hero-pebble" class="story-pebble" />
        <h1 class="display story-headline">
          <span class="story-word" style="--i: 0">The whole web.</span><br />
          <span class="story-word" style="--i: 1">A fraction</span>{" "}
          <span class="story-word" style="--i: 2">of the weight.</span>
        </h1>
        <p class="story-lede">Mote is the browser built around it. Native, open source, and under 6&nbsp;MB.</p>
        <div class="story-actions">
          <Button href={site.download}><Icon name="download" />Download for Mac</Button>
          <Button href={site.repo} tone="light"><Icon name="github" />View on GitHub</Button>
        </div>
        <p class="story-meta">{site.requirements} · Free</p>
      </header>

      <div class="story-card part">
        <div class="story-bar part" aria-hidden="true">
          <div class="story-bar-row part">
            <span class="door"><Icon name="sidebar" class="size-[14px]" /></span>
            <span class="door ml-1"><Icon name="back" class="size-[14px]" /></span>
            <span class="door opacity-30"><Icon name="forward" class="size-[14px]" /></span>
            <span class="door"><Icon name="reload" class="size-[14px]" /></span>
            <span class="story-address">
              <span class="address part is-ours">
                <i><Icon name="lock" class="size-[10px]" /></i>motebrowser.com
              </span>
              <span class="address part is-blank">
                <Icon name="search" class="size-[12px]" />Search or enter address
              </span>
              <span class="address part is-theirs">
                <i><Icon name="sparkle" class="size-[11px]" /></i>{question}
              </span>
            </span>
          </div>
        </div>

        <div class="story-view part">
        <div class="story-reel">
          <article class="story-essay part">
            {manifesto.map((line, i) => (
              <p class="part" style={spot(i)}>
                {line}
              </p>
            ))}
          </article>
        </div>

        <div class="story-newtab part" aria-hidden="true">
          <span class="newtab-logo">
            <Pebble id="newtab-pebble" class="story-newtab-pebble" />
            <svg class="logo-ring part" viewBox="0 0 564 550">
              <defs>
                <linearGradient id="logo-ring-light" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#fff3e6"></stop>
                  <stop offset="0.4" stop-color="#f6c6a8"></stop>
                  <stop offset="0.75" stop-color="#e7a58e"></stop>
                  <stop offset="1" stop-color="#f4dcc0"></stop>
                </linearGradient>
              </defs>
              <!-- The pebble's outline from its lowest point, each way round (Logomark.round). -->
              <g transform="translate(282 275) scale(1.045) translate(-282 -275)">
                <path pathLength="100" d="M284 540C124 550 0 470 2 318C4 170 94 58 234 32C404 0 564 100 560 270C556 420 454 530 284 540Z"></path>
                <path pathLength="100" d="M284 540C454 530 556 420 560 270C564 100 404 0 234 32C94 58 4 170 2 318C0 470 124 550 284 540Z"></path>
              </g>
            </svg>
            <span class="logo-drop part"></span>
          </span>
          <div class="composer-box">
          <span class="composer-aura part"><i></i></span>
          <div class="composer part">
            <span class="composer-halo part"><i></i></span>
            <div class="composer-field">
              <span class="composer-mark">
                <Icon name="search" class="mark-search part size-[13px]" />
                <Icon name="sparkle" class="mark-ask part size-[14px]" />
              </span>
              <span class="composer-hint is-search part">Search or enter an address</span>
              <span class="composer-hint is-ask part">Ask anything</span>
              <span class="composer-typed part">{question}</span>
            </div>
            <div class="composer-foot">
              <span class="composer-tools">
                <span class="tool is-ask part"><Icon name="sparkle" class="size-[11px]" />Ask<kbd>⌘J</kbd></span>
                <span class="tool-rule part"></span>
                <span class="tool is-research part"><Icon name="binoculars" class="size-[12px]" />Research</span>
              </span>
              <span class="composer-model part">Sonnet<Icon name="chevron" class="size-[10px]" /></span>
              <span class="composer-send part"><Icon name="up" class="size-[14px]" /></span>
            </div>
          </div>
          </div>
          <span class="story-keys part"><kbd>⌘</kbd><kbd>J</kbd></span>
        </div>

        <div class="story-chat part" aria-hidden="true">
          <div class="chat-column part">
            <p class="chat-question part">{question}</p>
            <div class="chat-answer">
              <p class="chat-author"><Icon name="sparkle" class="size-[10px]" />Claude Code · Sonnet</p>
              <div class="chat-research part">
                <p class="chat-headline">
                  <span class="chat-ring part"></span>
                  <Icon name="search" class="chat-done part size-[12px]" />
                  <span class="chat-status is-live part">Researching · planning</span>
                  <span class="chat-status is-done part">Researched 4 parts · 11 searches · 23 pages</span>
                </p>
                <ol class="chat-parts">
                  {
                    parts.map((part, i) => (
                      <li class="part" style={`--from: ${partAt(i).toFixed(3)}; --to: ${(partAt(i) + 0.006).toFixed(3)}`}>
                        <span class="chat-mark">
                          <span class="chat-ring is-small part" style={`--from: ${doneAt(i).toFixed(3)}; --to: ${(doneAt(i) + 0.002).toFixed(3)}`} />
                          <span class="chat-tick part" style={`--from: ${doneAt(i).toFixed(3)}; --to: ${(doneAt(i) + 0.003).toFixed(3)}`}>
                            <Icon name="check" class="size-[11px]" />
                          </span>
                        </span>
                        <span class="chat-part-title">{part.title}</span>
                        <span class="chat-tally part" style={`--from: ${doneAt(i).toFixed(3)}; --to: ${(doneAt(i) + 0.003).toFixed(3)}`}>
                          <Icon name="search" class="size-[9px]" />
                          {part.searches}
                          <span class="chat-page" />
                          {part.pages}
                        </span>
                      </li>
                    ))
                  }
                </ol>
              </div>
              <div class="chat-sources">
                {
                  sources.map((source, i) => (
                    <span
                      class:list={["chat-source part", { "is-uncited": source.number === 0 }]}
                      style={`--from: ${sourceAt(i).toFixed(3)}; --to: ${(sourceAt(i) + 0.005).toFixed(3)}`}
                    >
                      <span class="chat-source-site">
                        <Favicon site={source.site} class="size-[14px] shrink-0" />
                        {source.name}
                        {source.number > 0 && <b>{source.number}</b>}
                      </span>
                      <span class="chat-source-title">{source.title}</span>
                    </span>
                  ))
                }
              </div>
              <div class="chat-report">
                {
                  report.map((block) => {
                    const Tag = block.kind === "h" ? "h4" : "p";
                    return (
                      <Tag>
                        {block.words.split(" ").map((word) => {
                          const citation = word.match(/^\{(\d)\}$/);
                          return citation ? (
                            <span class="chat-word is-cite part" style={wordAt()}>
                              {cite(Number(citation[1]))}
                            </span>
                          ) : (
                            <span class="chat-word part" style={wordAt()}>
                              {word}{" "}
                            </span>
                          );
                        })}
                      </Tag>
                    );
                  })
                }
              </div>
              <p class="chat-buttons part">
                <Icon name="copy" class="size-[12px]" />
                <Icon name="reload" class="size-[12px]" />
              </p>
            </div>
          </div>
          <div class="chat-composer">
            <span class="chat-composer-hint">Ask a follow-up</span>
            <div class="chat-composer-foot">
              <span class="tool is-research is-on"><Icon name="binoculars" class="size-[12px]" />Research</span>
              <span class="composer-model">Sonnet<Icon name="chevron" class="size-[10px]" /></span>
              <span class="chat-stop part"><i></i></span>
            </div>
          </div>
        </div>
        </div>
      </div>

      <span class="story-hint part" aria-hidden="true">Scroll</span>
    </div>
    <!-- Above the page, as the window's own buttons are over the card when the sidebar is folded. -->
    <span class="story-lights" aria-hidden="true"><i></i><i></i><i></i></span>
    </div>

    <ol class="story-captions" aria-hidden="true">
      {
        captions.map((caption) => (
          <li class="story-caption part" style={`--from: ${caption.from}; --to: ${caption.to}`}>
            {caption.text}
          </li>
        ))
      }
    </ol>

    <div class="story-closing part">
      <h2 class="display">Just you and the page.</h2>
      <p class="story-closing-hint">Fold the sidebar away any time with <kbd>⌘</kbd><kbd>S</kbd></p>
    </div>
  </div>
</div>

<script>
  import { follow } from "../scripts/story";

  // Once the window has formed, its sidebar fills in, on a timer.
  const story = document.querySelector<HTMLElement>(".story")!;
  const stage = story.firstElementChild!;
  follow(story, (progress) => stage.classList.toggle("is-framed", progress > 0.09));
</script>
