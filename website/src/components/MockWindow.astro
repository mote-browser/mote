---
// A Mote window in its dark appearance, at its real size in points, for the
// close-ups: the frame, the traffic lights, the sidebar (optional) and the
// card with its toolbar. The page goes in the default slot; anything that
// floats over the window (a menu, a floating video) in the "over" slot.
// The read fill and the puzzle button are scene parts, for a page to animate.
// Layout and colours follow ChromeLayout.swift, Sidebar.swift, Toolbar.swift
// and the dark Palette in Design.swift.
import Favicon from "./Favicon.astro";
import Icon from "./Icon.astro";

interface Props {
  width: number;
  height: number;
  sidebar?: boolean;
  /** The host in the address bar; none shows "Search or enter address". */
  host?: string;
  /** Extensions pinned in the toolbar, with the puzzle button after them. */
  extensions?: boolean;
  class?: string;
  style?: string;
}

const { width, height, sidebar = false, host, extensions = false, class: className, style } = Astro.props;

const pins = ["post", "tally", "sidetrack"] as const;
const tabs = [
  { title: "On walking slowly", site: "notes", active: true },
  { title: "mote-browser/mote", site: "github" },
  { title: "Lisbon — 7-day forecast", site: "weather", loading: true },
  { title: "Recipes for a slow Sunday", site: "kettle" },
  { title: "A year of slow walks", site: "frames", playing: true },
  { title: "Reading list", site: "shelf" },
] as const;
---

<div class:list={["mw", className]} style={`width: ${width}px; height: ${height}px; ${style ?? ""}`}>
  <span class="mw-lights"><i></i><i></i><i></i></span>
  {
    sidebar && (
      <div class="mw-side">
        <div class="mw-pins">
          {pins.map((site) => (
            <span>
              <Favicon site={site} class="size-[17px]" />
            </span>
          ))}
        </div>
        {tabs.map((tab) => (
          <span class:list={["mw-row", { "is-lifted": "active" in tab }]}>
            {"active" in tab && <i class="mw-read part" />}
            <Favicon site={tab.site} class="size-4 shrink-0" />
            <span class="mw-title">{tab.title}</span>
            {"loading" in tab && <i class="mw-ring" />}
            {"playing" in tab && (
              <svg class="mw-speaker" viewBox="0 0 16 16">
                <path d="M3 6h2.5L9 3v10L5.5 10H3z" fill="currentColor" />
                <path
                  d="M11 5.5a3.5 3.5 0 0 1 0 5M12.8 3.8a6 6 0 0 1 0 8.4"
                  stroke="currentColor"
                  stroke-width="1.2"
                  fill="none"
                  stroke-linecap="round"
                />
              </svg>
            )}
          </span>
        ))}
        <span class="mw-row is-quiet">
          <Icon name="plus" class="size-[11px]" />
          New tab
        </span>
      </div>
    )
  }
  <div class="mw-card" style={`left: ${sidebar ? 240 : 8}px`}>
    <div class="mw-bar" style={sidebar ? "" : "padding-left: 78px"}>
      {sidebar && <span class="mw-door"><Icon name="sidebar" class="size-[13px]" /></span>}
      <span class="mw-door"><Icon name="back" class="size-[13px]" /></span>
      <span class="mw-door is-off"><Icon name="forward" class="size-[13px]" /></span>
      <span class="mw-door"><Icon name="reload" class="size-[13px]" /></span>
      <span class:list={["mw-address", { "is-blank": !host }]}>
        {
          host ? (
            <>
              <i>
                <Icon name="lock" class="size-[10px]" />
              </i>
              {host}
            </>
          ) : (
            <>
              <Icon name="search" class="size-[12px]" />
              Search or enter address
            </>
          )
        }
      </span>
      {
        extensions && (
          <>
            <span class="mw-pinned">
              <svg viewBox="0 0 16 16">
                <path d="M8 1.8 13 4v4.2c0 3-2.2 5.2-5 6-2.8-.8-5-3-5-6V4z" fill="#3fb68b" />
              </svg>
              <b>12</b>
            </span>
            <span class="mw-pinned">
              <svg viewBox="0 0 16 16">
                <rect x="2.5" y="2.5" width="11" height="11" rx="3" fill="#f5b544" />
                <path d="M5.5 6h5M5.5 8.2h5M5.5 10.4h3" stroke="#3b2a12" stroke-width="1.2" stroke-linecap="round" />
              </svg>
            </span>
            <span class="mw-door mw-puzzle part">
              <Icon name="puzzle" class="size-[14px]" />
            </span>
          </>
        )
      }
    </div>
    <div class="mw-page"><slot /></div>
  </div>
  <slot name="over" />
</div>

<style>
  .mw {
    --frame: #121212;
    --ground: #1c1c1c;
    --lift: #282828;
    --ink: #ededed;
    --muted: #949494;
    --faint: #525252;
    --hairline: #333333;
    --wash: #2d2d2d;
    --veil: #ffffff13;
    --edge: #ffffff12;
    position: absolute;
    border-radius: 12px;
    background: var(--frame);
    box-shadow:
      inset 0 0.5px 0 #ffffff40,
      0 0 0 0.5px #000000cc,
      0 0 0 1px #ffffff14,
      0 4px 40px 8px #00000066;
    font-family: -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    font-size: 13px;
    letter-spacing: 0;
    line-height: 1.35;
    color: var(--ink);
    text-align: left;
  }

  .mw-lights {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 2;
    display: flex;
    gap: 8px;

    & i {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: #ff5f57;

      &:nth-child(2) {
        background: #febc2e;
      }

      &:nth-child(3) {
        background: #28c840;
      }
    }
  }

  .mw-side {
    position: absolute;
    inset: 0 auto 0 0;
    width: 240px;
    padding: 50px 10px 10px;
  }

  .mw-pins {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    margin-bottom: 10px;

    & span {
      display: grid;
      height: 36px;
      place-items: center;
      border-radius: 10px;
      background: var(--veil);
    }
  }

  .mw-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    margin-bottom: 2px;
    padding: 0 10px;
    overflow: hidden;
    border-radius: 10px;
    color: #ededed9e;
    white-space: nowrap;

    & > :not(.mw-read) {
      position: relative;
    }

    &.is-lifted {
      background: var(--lift);
      box-shadow:
        inset 0 0 0 0.5px var(--edge),
        0 1px 2px #0000004d;
      color: var(--ink);
    }

    &.is-quiet {
      color: var(--muted);
    }
  }

  .mw-title {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* How much of the page has been read. */
  .mw-read {
    position: absolute;
    inset: 0;
    background: #ededed0d;
    transform-origin: left;
    scale: 0.62 1;
  }

  .mw-ring {
    flex-shrink: 0;
    width: 13px;
    height: 13px;
    margin-left: auto;
    border: 1.5px solid #ededed26;
    border-top-color: var(--muted);
    border-radius: 50%;
  }

  .mw-speaker {
    flex-shrink: 0;
    width: 13px;
    height: 13px;
    margin-left: auto;
    color: var(--muted);
  }

  .mw-card {
    position: absolute;
    top: 8px;
    right: 8px;
    bottom: 8px;
    overflow: hidden;
    border-radius: 10px;
    background: var(--ground);
    box-shadow:
      0 0 0 1px var(--edge),
      0 4px 12px #00000059;
  }

  .mw-bar {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 36px;
    padding: 0 6px;
    border-bottom: 1px solid var(--hairline);
  }

  .mw-door {
    display: grid;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    place-items: center;
    border-radius: 8px;
    color: #ededed99;

    &.is-off {
      opacity: 0.3;
    }
  }

  .mw-address {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 7px;
    height: 28px;
    margin: 0 6px;
    padding-left: 6px;
    color: #ededede0;

    & i {
      display: grid;
      width: 20px;
      height: 20px;
      place-items: center;
      border-radius: 50%;
      color: var(--muted);
    }

    &.is-blank {
      padding-left: 8px;
      color: var(--muted);
    }
  }

  .mw-pinned {
    position: relative;
    display: grid;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    place-items: center;
    border-radius: 8px;

    & svg {
      width: 15px;
      height: 15px;
    }

    & b {
      position: absolute;
      right: -3px;
      bottom: 0;
      min-width: 12px;
      height: 11px;
      padding: 0 3px;
      border-radius: 6px;
      background: var(--ink);
      font-size: 8px;
      font-weight: 600;
      line-height: 11px;
      color: #1c1c1c;
      text-align: center;
    }
  }

  .mw-page {
    position: relative;
    height: calc(100% - 37px);
  }
</style>
