KINDS = {"float": float, "int": int, "path": os.path.abspath}


def shown(arguments):
    """The arguments as help shows them: ID [SECONDS], without their kinds."""
    def one(token):
        bare = token.strip("[]").split(":")[0]
        name = bare if "|" in bare else bare.upper()
        return f"[{name}]" if token.startswith("[") else name
    return " ".join(map(one, arguments.split()))


def usage(verb):
    return f"usage: bench {verb} {shown(COMMANDS[verb][0])}".rstrip()


def read(verb, args):
    """The request for `verb`, from its arguments as the table describes them."""
    if verb in READERS:
        return READERS[verb](args)
    request, words = {}, list(args)
    for token in COMMANDS[verb][0].split():
        optional = token.startswith("[")
        token = token.strip("[]")
        choices = token.split("|") if "|" in token else None
        if not words or (choices and words[0] not in choices):
            if optional:
                continue
            sys.exit(usage(verb))
        if choices:
            request[CHOICES.get(verb, "action")] = words.pop(0)
        else:
            key, _, kind = token.partition(":")
            request[key] = KINDS[kind](words.pop(0)) if kind else words.pop(0)
    if words:
        sys.exit(usage(verb))
    return request


# Where a word chosen from a list goes, when it isn't "action".
CHOICES = {"ext-answer": "answer"}


def with_mods(verb, fixed, allowed, always=False):
    """Some fixed arguments, then any of some modifier words."""
    def reader(args):
        mods = [word for word in args[fixed:] if word in allowed]
        if len(args) < fixed or len(args) != fixed + len(mods):
            sys.exit(usage(verb))
        request = {}
        for token, word in zip(COMMANDS[verb][0].split(), args[:fixed]):
            key, _, kind = token.partition(":")
            request[key] = KINDS[kind](word) if kind else word
        if mods or always:
            request["mods"] = mods
        return request
    return reader


def read_eval(args):
    if len(args) not in (2, 3) or (len(args) == 3 and args[2] != "mote"):
        sys.exit(usage("eval"))
    return {"id": args[0], "js": args[1], **({"world": "mote"} if len(args) == 3 else {})}


def read_site(args):
    if not 1 <= len(args) <= 2:
        sys.exit(usage("site"))
    return {"path": os.path.abspath(args[0]), **({"security": args[1] == "security"} if len(args) == 2 else {})}


def read_space(args):
    shapes = {"delete": (), "release": (), "go": ("index", int), "move": ("index", int), "swipe": ("dx", float), "hold": ("dx", float)}
    if not args:
        return {}
    if args[0] == "new":
        fresh = args[-1] == "fresh"
        return {"action": "new", "name": " ".join(args[1:-1] if fresh else args[1:]) or "Test", "fresh": fresh}
    shape = shapes.get(args[0])
    if shape is None or len(args) != 1 + len(shape[:1]):
        sys.exit(usage("space"))
    request = {"action": args[0]}
    if shape:
        request[shape[0]] = shape[1](args[1])
    return request


def read_ui(args):
    if len(args) != 2:
        sys.exit(usage("ui"))
    key, value = args
    return {key: value if key in ("look", "edittab", "peeklink", "sitecard", "notice") else value in ON}


def read_hit(args):
    if len(args) not in (2, 3) or (len(args) == 3 and args[2] not in ("double", "middle")):
        sys.exit(usage("hit"))
    request = {"x": float(args[0]), "y": float(args[1])}
    if len(args) == 3:
        request[args[2]] = True
    return request


def read_words(verb, first, words):
    """A first argument, then any of some words, each true when given."""
    def reader(args):
        if len(args) < len(first) or any(word not in words for word in args[len(first):]):
            sys.exit(usage(verb))
        request = dict(zip(first, args))
        for word in words:
            request[word] = word in args[len(first):]
        return request
    return reader


def read_switch(verb, needed):
    """An optional id, then on or off (on when left out and not `needed`)."""
    def reader(args):
        count = len(args) - (1 if verb != "pages" else 0)
        if count not in ((1,) if needed else (0, 1)):
            sys.exit(usage(verb))
        request = {"id": args[0]} if verb != "pages" else {}
        request["on"] = (args[-1] if count else "on") in ON
        return request
    return reader


def read_frames(args):
    if len(args) > 2 or (args and args[0] not in ("fold", "peek", "unpeek", "scroll", "chat", "chatdown")):
        sys.exit(usage("frames"))
    request = {"action": args[0] if args else "fold"}
    if len(args) > 1:
        request["seconds"] = float(args[1])
    return request


def read_chat(args):
    action = args[0] if args else "show"
    rest = args[1:]
    if action in ("show", "providers") and not rest:
        return {"action": action}
    if action == "search" and len(rest) == 1 and rest[0] in ("on", "off"):
        return {"action": action, "on": rest[0] == "on"}
    if action == "demo" and len(rest) <= 3:
        request = {"action": action}
        if rest:
            request["sources"] = int(rest[0])
        if len(rest) > 1:
            request["delay"] = float(rest[1])
        if len(rest) > 2:
            request["plain"] = rest[2] == "plain"
        return request
    if action == "mode" and len(rest) == 1 and rest[0] in ("chat", "search", "research"):
        return {"action": action, "mode": rest[0]}
    if action == "lead" and len(rest) == 1 and rest[0] in ("search", "ask"):
        return {"action": action, "mode": rest[0]}
    if action in ("ask", "follow") and rest:
        return {"action": action, "text": " ".join(rest)}
    if action == "wait" and len(rest) <= 1:
        return {"action": action, "seconds": float(rest[0]) if rest else 60.0}
    if action == "use" and 1 <= len(rest) <= 3:
        request = {"action": action, "provider": rest[0]}
        if len(rest) >= 2:
            request["model"] = rest[1]
        if len(rest) == 3:
            request["address"] = rest[2]
        return request
    sys.exit(usage("chat"))


READERS = {
    "chat": read_chat,
    "tap": with_mods("tap", 2, ("shift", "cmd", "opt")),
    "press": lambda args: with_mods("press", 2, ("cmd", "shift", "ctrl", "opt", "repeat"), always=True)(args) if len(args) >= 2 else sys.exit(usage("press")),
    "keyeq": with_mods("keyeq", 2, ("shift",), always=True),
    "eval": read_eval,
    "site": read_site,
    "space": read_space,
    "ui": read_ui,
    "hit": read_hit,
    "field": read_words("field", ("text",), ("type", "go")),
    "bookmark": read_words("bookmark", ("url",), ("new",)),
    "menu": read_words("menu", (), ("open",)),
    "ext-pin": read_switch("ext-pin", needed=False),
    "ext-enable": read_switch("ext-enable", needed=True),
    "pages": read_switch("pages", needed=True),
    "frames": read_frames,
    "close": lambda args: {"id": args[0]} if len(args) == 1 else sys.exit(usage("close")),
    "ext-page": lambda args: {"id": args[0], "path": args[1] if len(args) > 1 else ""} if 1 <= len(args) <= 2 else sys.exit(usage("ext-page")),
}


def folder(world):
    return os.path.expanduser(f"~/Library/Application Support/{f'Mote ({world})' if world else 'Mote'}")


def ask(path, request):
    """Sends one request and reads its one answer."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        try:
            connection.connect(path)
        except (FileNotFoundError, ConnectionRefusedError):
            sys.exit("Mote isn't listening — is it open, with Settings › General › “Let a script drive Mote” on?")
        connection.sendall((json.dumps(request) + "\n").encode())
        received = b"".join(iter(lambda: connection.recv(1 << 16), b""))
    return json.loads(received.split(b"\n", 1)[0] or b"{}")


def world_of(argv):
    """The world named by --test or --world NAME, and the arguments left."""
    world = "test" if "--test" in argv else None
    if "--world" in argv:
        at = argv.index("--world")
        if at + 1 >= len(argv):
            sys.exit("usage: bench --world NAME COMMAND …")
        world = "".join(c for c in argv[at + 1].lower() if c.isascii() and (c.isalnum() or c == "-"))
        if world in ("", "1"):
            world = "test"
        argv = argv[:at] + argv[at + 2:]
    return world, argv


def show(verb, answer):
    if verb == "text":
        print(answer.get("text", ""))
        if answer.get("truncated"):
            print("\n[… truncated]", file=sys.stderr)
    elif verb == "shot":
        print(answer["path"])
    elif verb in ("open", "ext-page"):
        print(answer["id"])
    elif verb in ("eval", "ext-popup"):
        value = answer.get("value")
        print(value if isinstance(value, str) else json.dumps(value, ensure_ascii=False, indent=2))
    elif verb == "tabs":
        for tab in answer.get("tabs", []):
            mark = "⚗" if tab.get("bench") else ("●" if tab.get("active") else " ")
            state = " …" if tab.get("loading") else (" z" if tab.get("asleep") else "")
            print(f"{mark} {tab['id']}  {tab.get('title') or '—'}  {tab.get('url')}{state}")
    else:
        print(json.dumps(answer, ensure_ascii=False, indent=2))


def main(argv):
    world, argv = world_of(argv)
    yes = "--yes" in argv
    argv = [word for word in argv if word not in ("--test", "--yes")]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip() + "\n")
        for verb, (arguments, what) in COMMANDS.items():
            print(f"    Tools/bench {verb} {shown(arguments)}".ljust(52) + " " + what)
        return 0
    verb, args = argv[0], argv[1:]
    if verb not in COMMANDS:
        sys.exit(f"unknown command “{verb}” — see bench help")
    request = {"do": verb, **read(verb, args)}
    if verb in ("ext-add", "ext-folder", "ext-press", "ext-remove", "ext-reload"):
        request["yes"] = yes
    answer = ask(os.path.join(folder(world), "bench.sock"), request)
    if "error" in answer:
        sys.exit("error: " + str(answer["error"]))
    show(verb, answer)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
