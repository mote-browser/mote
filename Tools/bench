#!/usr/bin/env python3
"""Drive a running Mote from the shell, through its bench socket.

Needs Settings › General › "Let a script drive Mote" on in that Mote. Tabs
are named by the start of their id, as `tabs` prints it. --test talks to
the test world ("Mote (test)"), --world NAME to "Mote (NAME)"; --yes skips
an extension's install question, in a test world only.
"""

import json
import os
import socket
import sys

ON = ("on", "true", "1", "yes")

# Each command: its arguments, then what it does. An argument is KEY[:kind],
# in brackets when it may be left out, or a|b|c for one of some words.
# Kinds: float, int, path (made absolute). Commands whose
# arguments have a shape of their own are read by the functions in READERS.
COMMANDS = {
