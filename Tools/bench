    "close": ("id", "a tab the bench opened, or all of them"),
    "failure": ("id again|continue", "press a bench tab's failure page button: Try Again, or Continue past a bad certificate"),
    "place": ("id to:int", "put a tab at another place in the row"),
    "probe": ("", "the window's own state: panels, modal, windows"),
    "chat": ("[show|ask|follow|wait|use|mode|lead|search|providers] [args…]", "the chat in front; ask TEXT as the new tab's Ask does, follow TEXT in the chat "
             "(test run); wait [SECONDS] for its reply; use PROVIDER [MODEL] [ADDRESS], mode chat|search|research, search on|off, demo [SOURCES] [MS] [plain] (a long researched reply, streamed from Mote itself; plain: without research steps; test run); providers: how each stands"),
