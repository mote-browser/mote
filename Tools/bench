    "sleep": ("id", "put a tab to sleep now, or say what keeps it awake"),
    "select": ("id", "bring a tab to the front — test runs only"),
    "text": ("id", "the page's text"),
    "eval": ("id js [mote]", "run JavaScript and print what it gives back; mote: in Mote's own world"),
    "click": ("id selector", "element.click() on the first match"),
    "type": ("id selector text", "set a field's value as typing would"),
    "submit": ("id selector", "the form around SELECTOR"),
    "tap": ("id selector [mods…]", "a real mouse click on an element (or text=Words), shift/cmd/opt held — test runs only"),
