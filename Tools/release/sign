#!/usr/bin/env swift
// Signs a release file with Mote's private update key, printing the
// signature in base64 for appcast.json. The key comes from
// MOTE_UPDATE_PRIVATE_KEY (as in CI) or ~/.config/mote/update-key.
//
//   Tools/release/sign build/Mote.zip

import CryptoKit
import Foundation

guard CommandLine.arguments.count == 2 else {
    FileHandle.standardError.write(Data("usage: Tools/release/sign FILE\n".utf8)); exit(2)
}
let saved = FileManager.default.homeDirectoryForCurrentUser.appending(path: ".config/mote/update-key")
guard let text = ProcessInfo.processInfo.environment["MOTE_UPDATE_PRIVATE_KEY"] ?? (try? String(contentsOf: saved, encoding: .utf8)) else {
    FileHandle.standardError.write(Data("No key: set MOTE_UPDATE_PRIVATE_KEY, or make one with Tools/release/keys\n".utf8)); exit(1)
}
let digits = Array(text.trimmingCharacters(in: .whitespacesAndNewlines))
let bytes = digits.count == 64 ? stride(from: 0, to: 64, by: 2).compactMap { UInt8(String(digits[$0...$0 + 1]), radix: 16) } : []
guard bytes.count == 32, let key = try? Curve25519.Signing.PrivateKey(rawRepresentation: Data(bytes)) else {
    FileHandle.standardError.write(Data("The key isn't 64 hex digits\n".utf8)); exit(1)
}
let file = URL(fileURLWithPath: CommandLine.arguments[1])
guard let data = try? Data(contentsOf: file) else {
    FileHandle.standardError.write(Data("Can't read \(file.path)\n".utf8)); exit(1)
}
print(try key.signature(for: data).base64EncodedString())
