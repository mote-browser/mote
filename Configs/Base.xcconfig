// Settings shared by every target. Debug.xcconfig and Release.xcconfig
// include this at the project level; each target adds its own file on top.
// Documentation: https://help.apple.com/xcode/#/dev745c5c974

#include "Version.xcconfig"

MACOSX_DEPLOYMENT_TARGET = 14.0
SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
ARCHS = arm64

SWIFT_VERSION = 6.0

// Unsigned for now: "Sign to Run Locally" (ad hoc), no team, no Developer ID.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

MOTE_BUNDLE_ID = io.github.mote-browser.mote

DEAD_CODE_STRIPPING = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
CLANG_ENABLE_MODULES = YES
